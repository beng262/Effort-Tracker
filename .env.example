# Copy to .env for local runs against a real PostgreSQL. In Azure these come from app settings / Key Vault.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://user:pass@localhost:5432/efor
SESSION_SECRET=change-me-to-a-long-random-string

# entra (real sign-in) or dev (local only; refused when NODE_ENV=production)
AUTH_MODE=entra
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# tenantId:Name:domain, comma separated. Exactly these two tenants may sign in.
ALLOWED_TENANTS=<alpha-tenant-id>:Alpha:alpha.example.com,<beta-tenant-id>:Beta:beta.example.com

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-sol

# Blank = files go to LOCAL_UPLOAD_DIR instead of Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
LOCAL_UPLOAD_DIR=.data/uploads

SYNC_ENABLED=false
SYNC_INTERVAL_MIN=30
SCHEDULER_ENABLED=false
SMTP_URL=
MAIL_FROM=efor@alpha.example.com
DEFAULT_DAY_HOURS=8
